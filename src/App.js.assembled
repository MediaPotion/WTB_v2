    setDraggedRowId(null);
    setIsDraggingOver(false);
    // Remove any lingering drop indicators
    document.querySelectorAll('.timeline-row').forEach(el => {
      el.style.borderTop = 'none';
      el.style.marginTop = '0';
    });
  };


