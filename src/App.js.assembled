            </div>

            <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
              <button
                onClick={() => { setWizardStep(1); setScreen("wizard"); }}
                style={{ padding: "18px 32px", backgroundColor: "#4CAF50", color: "white", border: "none", borderRadius: 8, fontSize: 18, fontWeight: "bold", cursor: "pointer", width: "100%" }}
