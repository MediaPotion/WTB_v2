              alignItems: "center",
              justifyContent: "center",
              fontSize: 12,
              fontWeight: "bold",
            }}
          >
            A
          </button>

          {/* Color palette */}
          {COLOR_PALETTE.map((color) => (
            <button
              key={color.value}
              type="button"
              onClick={() => {
                onChange(color.value);
                setIsOpen(false);
              }}
              title={color.name}
              style={{
                width: 28,
                height: 28,
                borderRadius: "50%",
                border:
                  currentColor === color.value
                    ? "3px solid #b8906a"
