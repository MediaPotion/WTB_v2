              onChange("");
              setIsOpen(false);
            }}
            title="Auto color"
            style={{
              width: 28,
              height: 28,
              borderRadius: "50%",
              border: autoMode ? "3px solid #b8906a" : "2px solid #2a2520",
              backgroundColor: "#161310",
